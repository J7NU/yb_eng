{
  // Cloudflare Workers 배포 설정
  //
  // 이 저장소는 빌드 과정이 없는 정적 사이트다. 공사 중에는 접근 잠금(HTTP Basic)
  // 스크립트를 앞단에 뒀었으나, 공개 전환(2026-08-09)과 함께 걷어내고
  // 순수 assets-only 배포로 되돌렸다.
  //
  // ▸ 스크립트가 사라지면서 모든 응답에 붙던 `X-Robots-Tag: noindex, nofollow` 와
  //   `Cache-Control: private, no-store` 도 함께 사라진다. 이제 검색엔진이
  //   색인할 수 있고, _headers 의 캐시 규칙이 정상 적용된다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yb-eng",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./",
    // 없는 경로는 404.html 을 404 상태로 반환한다.
    // SPA 폴백(single-page-application)을 쓰면 200 으로 응답해
    // 검색엔진에 soft 404 가 생기므로 쓰지 않는다.
    "not_found_handling": "404-page"
  }
}
